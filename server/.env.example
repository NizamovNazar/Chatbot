# V22. Never put real secrets in this template or Git.
NODE_ENV=development
PORT=5000
# HOST=127.0.0.1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Preferred in production; npm run auth:hash generates this interactively.
ADMIN_PASSWORD_HASH=
# JSON production: one process on a verified durable volume only.
# AUTH_FILE_PERSISTENT=1
ADMIN_SESSION_MS=28800000
LOGIN_REQUEST_MAX=60
LOGIN_RATE_MAX=7
LOGIN_ACCOUNT_MAX=12
LOGIN_BLOCK_MS=900000
CHAT_RATE_MAX=40
FEEDBACK_RATE_MAX=30
# CORS_ORIGINS=https://your-ui.example
# Enable only behind exactly one trusted proxy, with no direct Node access.
# TRUST_PROXY=1
# NEW empty DB: explicit sql:bootstrap required. No private JSON auto-import.
DATABASE_URL=
SITE_URLS=https://vstup.oa.edu.ua/,https://www.oa.edu.ua/
CRAWL_MAX_PAGES=300
CRAWL_MAX_DEPTH=3
KNOWLEDGE_CHECK_MS=5000
AI_PROVIDERS=gemini,openrouter,cloudflare
AI_TIMEOUT_MS=12000
AI_TOTAL_TIMEOUT_MS=35000
AI_MAX_TOKENS=1200
# Concurrency per process; persistent daily upstream attempts including fallbacks.
# This cap is not a monetary estimate or a promise of free provider access.
AI_MAX_CONCURRENT=2
AI_DAILY_ATTEMPTS=40
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
